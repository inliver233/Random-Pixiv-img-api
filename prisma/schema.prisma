generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProxyScheme {
  http
  https
  socks4
  socks5
}

model Image {
  id            BigInt   @id @default(autoincrement())
  illustId       BigInt   @map("illust_id") @db.BigInt
  pageIndex      Int      @map("page_index")
  ext           String   @db.Text

  originalUrl   String   @map("original_url") @db.Text
  proxyPath     String   @map("proxy_path") @db.Text

  width         Int?
  height        Int?
  aspectRatio   Float?   @map("aspect_ratio") @db.Real
  orientation   Int?     @db.SmallInt

  xRestrict     Int?     @map("x_restrict") @db.SmallInt
  aiType        Int?     @map("ai_type") @db.SmallInt

  userId        BigInt?  @map("user_id") @db.BigInt
  userName      String?  @map("user_name") @db.Text
  title         String?  @db.Text
  createdAtPixiv DateTime? @map("created_at_pixiv")

  status        Int      @default(1) @db.SmallInt
  failCount     Int      @default(0) @map("fail_count")
  lastFailAt    DateTime? @map("last_fail_at")
  lastOkAt      DateTime? @map("last_ok_at")
  lastErrorCode String?  @map("last_error_code") @db.Text
  lastErrorMsg  String?  @map("last_error_msg") @db.Text

  randomKey     Float    @map("random_key") @db.Real

  addedAt       DateTime @default(now()) @map("added_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  imageTags     ImageTag[]

  @@unique([illustId, pageIndex], map: "images_uniq")
  @@index([status, xRestrict, orientation, width, height, randomKey], map: "images_filter_idx")
  @@map("images")
}

model Tag {
  id             BigInt  @id @default(autoincrement())
  name           String  @unique @db.Text
  translatedName String? @map("translated_name") @db.Text

  imageTags      ImageTag[]

  @@map("tags")
}

model ImageTag {
  imageId BigInt @map("image_id") @db.BigInt
  tagId   BigInt @map("tag_id") @db.BigInt

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([imageId, tagId])
  @@index([tagId, imageId], map: "image_tags_tag")
  @@map("image_tags")
}

model Import {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Text
  source    String?  @db.Text
  total     Int
  success   Int
  failed    Int
  detail    Json?    @db.JsonB

  @@map("imports")
}

model AdminAudit {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  actor     String? @db.Text
  action    String  @db.Text
  resource  String  @db.Text
  recordId  String? @map("record_id") @db.Text

  fromStatus Int? @map("from_status") @db.SmallInt
  toStatus   Int? @map("to_status") @db.SmallInt

  requestId String? @map("request_id") @db.Text
  ip        String? @db.Text
  userAgent String? @map("user_agent") @db.Text

  detail Json? @db.JsonB

  @@index([createdAt], map: "admin_audit_created_at")
  @@index([action], map: "admin_audit_action")
  @@index([resource], map: "admin_audit_resource")
  @@index([recordId], map: "admin_audit_record_id")
  @@map("admin_audit")
}

model RequestLog {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  requestId String? @map("request_id") @db.Text
  method    String  @db.Text
  route     String  @db.Text
  url       String? @db.Text

  status     Int @db.SmallInt
  durationMs Int @map("duration_ms")

  ip        String? @db.Text
  userAgent String? @map("user_agent") @db.Text

  sampleRate Float? @map("sample_rate") @db.Real

  @@index([createdAt], map: "request_log_created_at")
  @@index([route], map: "request_log_route")
  @@index([status], map: "request_log_status")
  @@map("request_log")
}

model PixivToken {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  label   String? @db.Text
  enabled Boolean @default(true)

  refreshToken       String @map("refresh_token") @db.Text
  refreshTokenMasked String @map("refresh_token_masked") @db.Text

  bindings TokenProxyBinding[]

  @@index([enabled], map: "pixiv_tokens_enabled")
  @@map("pixiv_tokens")
}

model ProxyEndpoint {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  scheme ProxyScheme
  host   String      @db.Text
  port   Int

  username String @default("") @db.Text
  password String @default("") @db.Text

  enabled   Boolean @default(true)
  source    String  @default("manual") @db.Text
  sourceRef String? @map("source_ref") @db.Text

  pools           ProxyPoolEndpoint[]
  primaryBindings TokenProxyBinding[] @relation("binding_primary_proxy")
  overrideBindings TokenProxyBinding[] @relation("binding_override_proxy")

  @@unique([scheme, host, port, username], map: "proxy_endpoints_identity")
  @@index([enabled], map: "proxy_endpoints_enabled")
  @@index([source], map: "proxy_endpoints_source")
  @@map("proxy_endpoints")
}

model ProxyPool {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  name        String  @db.Text
  description String? @db.Text
  enabled     Boolean @default(true)

  endpoints ProxyPoolEndpoint[]
  bindings  TokenProxyBinding[]

  @@unique([name], map: "proxy_pools_name_uniq")
  @@index([enabled], map: "proxy_pools_enabled")
  @@map("proxy_pools")
}

model ProxyPoolEndpoint {
  poolId     BigInt @map("pool_id") @db.BigInt
  endpointId BigInt @map("endpoint_id") @db.BigInt

  enabled Boolean @default(true)
  weight  Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  pool     ProxyPool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  endpoint ProxyEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([poolId, endpointId])
  @@index([endpointId, poolId], map: "proxy_pool_endpoints_endpoint")
  @@index([poolId, enabled], map: "proxy_pool_endpoints_enabled")
  @@map("proxy_pool_endpoints")
}

model TokenProxyBinding {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tokenId BigInt @map("token_id") @db.BigInt
  poolId  BigInt @map("pool_id") @db.BigInt

  primaryProxyId     BigInt   @map("primary_proxy_id") @db.BigInt
  overrideProxyId    BigInt?  @map("override_proxy_id") @db.BigInt
  overrideExpiresAt  DateTime? @map("override_expires_at")

  token        PixivToken    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  pool         ProxyPool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  primaryProxy ProxyEndpoint @relation("binding_primary_proxy", fields: [primaryProxyId], references: [id], onDelete: Restrict)
  overrideProxy ProxyEndpoint? @relation("binding_override_proxy", fields: [overrideProxyId], references: [id], onDelete: SetNull)

  @@unique([tokenId, poolId], map: "token_proxy_bindings_token_pool_uniq")
  @@index([poolId], map: "token_proxy_bindings_pool")
  @@index([primaryProxyId], map: "token_proxy_bindings_primary_proxy")
  @@index([overrideProxyId], map: "token_proxy_bindings_override_proxy")
  @@map("token_proxy_bindings")
}
