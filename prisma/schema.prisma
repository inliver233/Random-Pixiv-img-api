generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Image {
  id            BigInt   @id @default(autoincrement())
  illustId       BigInt   @map("illust_id") @db.BigInt
  pageIndex      Int      @map("page_index")
  ext           String   @db.Text

  originalUrl   String   @map("original_url") @db.Text
  proxyPath     String   @map("proxy_path") @db.Text

  width         Int?
  height        Int?
  aspectRatio   Float?   @map("aspect_ratio") @db.Real
  orientation   Int?     @db.SmallInt

  xRestrict     Int?     @map("x_restrict") @db.SmallInt
  aiType        Int?     @map("ai_type") @db.SmallInt

  userId        BigInt?  @map("user_id") @db.BigInt
  userName      String?  @map("user_name") @db.Text
  title         String?  @db.Text
  createdAtPixiv DateTime? @map("created_at_pixiv")

  status        Int      @default(1) @db.SmallInt
  failCount     Int      @default(0) @map("fail_count")
  lastFailAt    DateTime? @map("last_fail_at")
  lastOkAt      DateTime? @map("last_ok_at")
  lastErrorCode String?  @map("last_error_code") @db.Text
  lastErrorMsg  String?  @map("last_error_msg") @db.Text

  randomKey     Float    @map("random_key") @db.Real

  addedAt       DateTime @default(now()) @map("added_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  imageTags     ImageTag[]

  @@unique([illustId, pageIndex], map: "images_uniq")
  @@index([status, xRestrict, orientation, width, height, randomKey], map: "images_filter_idx")
  @@map("images")
}

model Tag {
  id             BigInt  @id @default(autoincrement())
  name           String  @unique @db.Text
  translatedName String? @map("translated_name") @db.Text

  imageTags      ImageTag[]

  @@map("tags")
}

model ImageTag {
  imageId BigInt @map("image_id") @db.BigInt
  tagId   BigInt @map("tag_id") @db.BigInt

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([imageId, tagId])
  @@index([tagId, imageId], map: "image_tags_tag")
  @@map("image_tags")
}

model Import {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Text
  source    String?  @db.Text
  total     Int
  success   Int
  failed    Int
  detail    Json?    @db.JsonB

  @@map("imports")
}

model AdminAudit {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  actor     String? @db.Text
  action    String  @db.Text
  resource  String  @db.Text
  recordId  String? @map("record_id") @db.Text

  fromStatus Int? @map("from_status") @db.SmallInt
  toStatus   Int? @map("to_status") @db.SmallInt

  requestId String? @map("request_id") @db.Text
  ip        String? @db.Text
  userAgent String? @map("user_agent") @db.Text

  detail Json? @db.JsonB

  @@index([createdAt], map: "admin_audit_created_at")
  @@index([action], map: "admin_audit_action")
  @@index([resource], map: "admin_audit_resource")
  @@index([recordId], map: "admin_audit_record_id")
  @@map("admin_audit")
}

model RequestLog {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  requestId String? @map("request_id") @db.Text
  method    String  @db.Text
  route     String  @db.Text
  url       String? @db.Text

  status     Int @db.SmallInt
  durationMs Int @map("duration_ms")

  ip        String? @db.Text
  userAgent String? @map("user_agent") @db.Text

  sampleRate Float? @map("sample_rate") @db.Real

  @@index([createdAt], map: "request_log_created_at")
  @@index([route], map: "request_log_route")
  @@index([status], map: "request_log_status")
  @@map("request_log")
}
