{
  "name": "pixivcat-backend",
  "version": "1.1.1",
  "description": "Pixiv.cat backend server",
  "main": "app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app.js",
    "start:prod": "node dist/app.js",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/views',{recursive:true}); fs.copyFileSync('views/error.ejs','dist/views/error.ejs');\"",
    "dev": "nodemon app.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "author": "jongcs",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "memcached": "^2.2.2",
    "qs": "^6.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.0.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
