    "adminjs": "^7.8.17",
    "axios": "^1.13.4",
    "axios-retry": "^4.5.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "memcached": "^2.2.2",
    "pg": "^8.18.0",
    "pg-boss": "^12.8.0",
    "pino": "^10.3.0",
    "prom-client": "^15.1.3",
    "qs": "^6.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
