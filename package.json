    "@types/express-session": "^1.18.2",
    "@types/memcached": "^2.2.10",
    "@types/node": "^24.10.9",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.0.0",
    "nodemon": "^3.1.7",
