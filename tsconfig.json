{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["app.ts", "src/**/*.js", "src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/routes/pixivRoutes.js",
    "src/controllers/imageProxyController.js",
    "src/services/pixivService.js",
    "src/services/pixivAuthService.js",
    "src/services/memcachedService.js",
    "src/utils/contentType.js",
    "src/middlewares/validationMiddleware.js",
    "src/middlewares/headerMiddleware.js"
  ]
}
