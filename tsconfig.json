{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["app.ts", "src/**/*.js", "src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/routes/pixivRoutes.js",
    "src/controllers/imageProxyController.js",
    "src/services/pixivService.js"
  ]
}
