# Server
HOST=0.0.0.0
PORT=3000

# Pixiv
# JSON array string (do NOT commit real tokens)
REFRESH_TOKENS=["token1","token2"]

# Memcached
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
MEMCACHED_NAMESPACE=pixiv

# Database (optional for legacy mode; required once DB features are enabled)
# DATABASE_URL=postgresql://user:password@localhost:5432/pixivcat
# DB_SSL=false

# Admin (optional; used by /admin)
# ADMIN_TOKEN=change-me
# ADMIN_IP_ALLOWLIST=127.0.0.1/32,10.0.0.0/8

# Rate limiting (optional)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# Metrics (optional)
# METRICS_ENABLED=true
# METRICS_ROUTE=/metrics

# Imgproxy (optional; only for JSON response signed URLs)
# IMGPROXY_URL=http://localhost:8080
# IMGPROXY_KEY=
# IMGPROXY_SALT=
