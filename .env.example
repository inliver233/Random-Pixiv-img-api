# ===============================
# pixivcat-backend (.env) 示例
# 适配：1Panel 反向代理 + Cloudflare
# 用法：复制为 .env，然后只改端口/密码/token 即可
# ===============================

# --- 基础设置 ---
# 宿主机暴露端口（容器内部固定监听 3000；对应 docker-compose.yml 的 ports 映射）
BACKEND_PORT=25566

# 反代（1Panel/Nginx/Caddy/Cloudflare）场景必须信任 X-Forwarded-* 头
TRUST_PROXY=1

# （可选）日志级别：silent|fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# --- Pixiv（必填）---
# JSON array string（不要提交真实 token 到 git）
REFRESH_TOKENS=["please_set_refresh_token"]

# --- 数据库（Postgres；/random /admin 等功能需要）---
# 推荐只设置 POSTGRES_*；Docker 启动脚本会自动拼接并对密码进行 URL 编码（支持 @ : / 等特殊字符）。
# 如需完全自定义连接参数，可直接设置 DATABASE_URL（会覆盖自动拼接）。
POSTGRES_USER=pixivcat
POSTGRES_PASSWORD=change_me_db_pass
POSTGRES_DB=pixivcat
# DATABASE_URL=postgresql://user:pass@postgres:5432/pixivcat?schema=public

# --- 后台（AdminJS）---
# Token 方式（首次访问可用 /admin?token=... 写入 cookie）
ADMIN_TOKEN=change_me_admin_token

# 账号密码登录（推荐）
ADMIN_SESSION_AUTH_ENABLED=true
ADMIN_SESSION_SECRET=change_me_session_secret
ADMIN_SESSION_USER=admin
ADMIN_SESSION_PASS=change_me_admin_pass

# （可选）导入限制（用于 Import URLs 页面 / POST /admin/images/import）
# ADMIN_IMPORT_MAX_FILE_BYTES=33554432
# ADMIN_IMPORT_MAX_LINES=0
# 大量导入优化：达到阈值后走 bulk 写入（更快更稳定）
# ADMIN_IMPORT_BULK_MIN_IMAGES=1000
# 超大导入时，逐个 enqueue 元数据补全任务会很慢（可能触发 Cloudflare/反代超时）。
# 0 表示不限制；否则超过阈值将跳过 enqueue，并在返回的 enqueued.note 里提示。
# ADMIN_IMPORT_MAX_HYDRATE_ILLUSTS=2000

# （强烈建议）后台 IP 白名单：逗号分隔或 CIDR；不设置=不启用白名单
# Cloudflare/反代场景请确保反代传递真实客户端 IP，并配合 TRUST_PROXY=1
# ADMIN_IP_ALLOWLIST=1.2.3.4/32,127.0.0.1,::1

# --- Memcached（Docker Compose 默认就是 memcached:11211；一般不用改）---
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
MEMCACHED_NAMESPACE=pixiv

# --- 限流（可选；CDN/反代场景建议开启）---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_API_KEY=1000
# RATE_LIMIT_API_KEYS=premium123,premium456

# --- 指标（Prometheus）---
METRICS_ENABLED=true
METRICS_ROUTE=/metrics
# （可选）给 /metrics 加 basic auth
# METRICS_BASIC_AUTH_USER=metrics
# METRICS_BASIC_AUTH_PASS=change_me_metrics_pass

# --- Imgproxy（可选；用于 /random?format=json 里返回签名 URL）---
# IMGPROXY_URL=http://imgproxy:8080
# IMGPROXY_KEY=
# IMGPROXY_SALT=
